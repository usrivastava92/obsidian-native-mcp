{
  "name": "obsidian-native-mcp",
  "version": "0.2.0",
  "description": "Zero-dependency MCP server for Obsidian vaults. Direct filesystem access — no Obsidian process or REST API plugin needed.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "obsidian-native-mcp": "./dist/obsidian-native-mcp"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --compile --minify --sourcemap --target=bun-darwin-arm64 --outfile dist/obsidian-native-mcp",
    "build:linux": "bun build ./src/index.ts --compile --minify --sourcemap --target=bun-linux-x64-baseline --outfile dist/obsidian-native-mcp-linux",
    "build:mac-arm64": "bun build ./src/index.ts --compile --minify --sourcemap --target=bun-darwin-arm64 --outfile dist/obsidian-native-mcp-macos-arm64",
    "build:mac-x64": "bun build ./src/index.ts --compile --minify --sourcemap --target=bun-darwin-x64 --outfile dist/obsidian-native-mcp-macos-x64",
    "build:windows": "bun build ./src/index.ts --compile --minify --sourcemap --target=bun-windows-x64-baseline --outfile dist/obsidian-native-mcp-windows.exe",
    "postbuild": "rm -f .*.bun-build",
    "clean": "rm -rf dist/ .*.bun-build",
    "dev": "bun --watch src/index.ts",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "start": "bun src/index.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3"
  }
}
